t;/td&gt;&lt;td&gt;Embebido y denormalizado — se congela al agregar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;items[].productId&lt;/td&gt;&lt;td&gt;number&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;→ products.id (FK lógica)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;items[].title&lt;/td&gt;&lt;td&gt;string&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Copia del título al momento de agregar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;items[].qty&lt;/td&gt;&lt;td&gt;number&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Entero &gt; 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;items[].unitPrice&lt;/td&gt;&lt;td&gt;number&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Centavos, ≥ 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;items[].supplierId&lt;/td&gt;&lt;td&gt;number | null&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;null = grupo &#39;Sin proveedor&#39;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;items[].supplierName&lt;/td&gt;&lt;td&gt;string&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Copia del nombre del proveedor&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;overflow=fill;spacing=4;" vertex="1" parent="1">
