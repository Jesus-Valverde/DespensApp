td&gt;iconKey / iconTone&lt;/td&gt;&lt;td&gt;string&lt;/td&gt;&lt;td&gt;Sí&lt;/td&gt;&lt;td&gt;Icono y tono visual de la tarjeta&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;customProps&lt;/td&gt;&lt;td&gt;CustomProp[]&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;[{key, value}] — tipos, ej. key=&#39;Tipo&#39;, value=&#39;Entera&#39;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;stock.current&lt;/b&gt;&lt;/td&gt;&lt;td&gt;number&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Stock global único del producto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;stock.min&lt;/td&gt;&lt;td&gt;number | null&lt;/td&gt;&lt;td&gt;Sí&lt;/td&gt;&lt;td&gt;Nivel mínimo (dispara aviso de stock bajo)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;stock.max&lt;/td&gt;&lt;td&gt;number | null&lt;/td&gt;&lt;td&gt;Sí&lt;/td&gt;&lt;td&gt;Nivel máximo (sugerencia de reposición)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;stock.location&lt;/td&gt;&lt;td&gt;string&lt;/td&gt;&lt;td&gt;Sí&lt;/td&gt;&lt;td&gt;Ubicación física (texto libre)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;stock.alerts&lt;/td&gt;&lt;td&gt;boolean&lt;/td&gt;&lt;td&gt;Sí&lt;/td&gt;&lt;td&gt;Alertar al cruzar el mínimo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;purchase.primarySupplierId&lt;/td&gt;&lt;td&gt;number&lt;/td&gt;&lt;td&gt;Sí&lt;/td&gt;&lt;td&gt;FK lógica → suppliers.id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;purchase.secondarySupplierIds&lt;/td&gt;&lt;td&gt;number[]&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Proveedores alternos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;purchase.originalPrice&lt;/td&gt;&lt;td&gt;number&lt;/td&gt;&lt;td&gt;Sí&lt;/td&gt;&lt;td&gt;Precio de referencia (centavos)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;purchase.lastPrice&lt;/td&gt;&lt;td&gt;number&lt;/td&gt;&lt;td&gt;Sí&lt;/td&gt;&lt;td&gt;Último precio pagado (centavos)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;purchase.lastPurchaseDate&lt;/td&gt;&lt;td&gt;date&lt;/td&gt;&lt;td&gt;Sí&lt;/td&gt;&lt;td&gt;&#39;AAAA-MM-DD&#39;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;purchase.nextPurchaseDate&lt;/td&gt;&lt;td&gt;date&lt;/td&gt;&lt;td&gt;Sí&lt;/td&gt;&lt;td&gt;index — al vencer dispara el carrito automático&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;purchase.period&lt;/td&gt;&lt;td&gt;enum | null&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;semanal · quincenal · mensual · null&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;purchase.links&lt;/td&gt;&lt;td&gt;{id, url}[]&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Enlaces de compra del producto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;purchase.supplierLinks&lt;/td&gt;&lt;td&gt;SupplierLink[]&lt;/td&gt;&lt;td&gt;Sí&lt;/td&gt;&lt;td&gt;{supplierId, price?, frequency?, url?, notes?} por proveedor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;createdAt / updatedAt&lt;/td&gt;&lt;td&gt;timestamp&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;ISO-8601&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;overflow=fill;spacing=4;" vertex="1" parent="1">
