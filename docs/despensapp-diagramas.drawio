<mxfile host="Electron" compressed="false" pages="10">
  <diagram id="idx" name="Índice">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="idx-t1" value="DespensApp — Documentación técnica del sistema" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="185" y="40" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="idx-t2" value="PWA offline-first de control de despensa · React + Vite + Dexie (IndexedDB) · sin backend" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="185" y="80" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="idx-list" value="&lt;table style=&#39;border-collapse:collapse;font-size:12px;&#39; cellpadding=&#39;6&#39; border=&#39;1&#39;&gt;&#xa;&lt;tr&gt;&lt;td bgcolor=&#39;#2d5f8b&#39; style=&#39;color:#ffffff;&#39;&gt;&lt;b&gt;Página&lt;/b&gt;&lt;/td&gt;&lt;td bgcolor=&#39;#2d5f8b&#39; style=&#39;color:#ffffff;&#39;&gt;&lt;b&gt;Contenido&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;1 · Contexto (C4 Nivel 1)&lt;/td&gt;&lt;td&gt;Sistema, usuario y colaboradores externos&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;2 · Contenedores (C4 Nivel 2)&lt;/td&gt;&lt;td&gt;SPA, Service Worker, Dexie, IndexedDB, archivos y despliegue&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;3 · Entidades (ERD)&lt;/td&gt;&lt;td&gt;6 tablas Dexie, campos y relaciones (cardinalidad)&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;4 · Diccionario de Datos&lt;/td&gt;&lt;td&gt;Campo, tipo, nulidad, restricciones y propósito&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;5 · Secuencia: Pagar carrito&lt;/td&gt;&lt;td&gt;buyCart() — transacción todo-o-nada&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;6 · Flujo: Registrar movimiento&lt;/td&gt;&lt;td&gt;entrada / salida / ajuste y actualización de stock&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;7 · Flujo: Respaldo y restauración&lt;/td&gt;&lt;td&gt;Exportación e importación local (.json)&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;8 · Flujo: Importar catálogo CSV&lt;/td&gt;&lt;td&gt;Validación por fila y creación de productos&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;9 · Flujo: Carrito automático&lt;/td&gt;&lt;td&gt;generateAutoCart() — reposición programada&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;/table&gt;" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="235" y="140" width="700" height="420" as="geometry" />
        </mxCell>
        <mxCell id="idx-note" value="&lt;b&gt;Alcance&lt;/b&gt;&lt;br&gt;· No hay especificación OpenAPI/Swagger: la app no tiene backend ni API REST — todos los datos viven localmente en el navegador (IndexedDB).&lt;br&gt;· Casos de uso omitidos: sistema de usuario único (el actor se documenta en el Contexto, página 1).&lt;br&gt;· Diagrama de despliegue incluido como nota en la página de Contenedores (página 2)." style="shape=note;whiteSpace=wrap;html=1;size=20;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="235" y="590" width="700" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
