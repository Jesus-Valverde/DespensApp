        </mxCell>
        <mxCell id="er-pd" parent="1" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;overflow=fill;" value="&lt;table style=&#39;width:100%;border-collapse:collapse;font-size:10px;&#39; border=&#39;1&#39; cellpadding=&#39;4&#39;&gt;&lt;tr&gt;&lt;td bgcolor=&#39;#6a4c93&#39; align=&#39;center&#39; style=&#39;color:#ffffff;&#39;&gt;&lt;b&gt;productDefs&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;color:#666666;&#39;&gt;índices: ++id, title&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;id&lt;/b&gt; : number — PK (auto)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;title&lt;/b&gt; : string (= products.title)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;props : [{key, value}]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;updatedAt : ISO-8601&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="140" y="60" as="geometry" />
        </mxCell>
        <mxCell id="er-sup" parent="1" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;overflow=fill;" value="&lt;table style=&#39;width:100%;border-collapse:collapse;font-size:10px;&#39; border=&#39;1&#39; cellpadding=&#39;4&#39;&gt;&lt;tr&gt;&lt;td bgcolor=&#39;#3d7a4f&#39; align=&#39;center&#39; style=&#39;color:#ffffff;&#39;&gt;&lt;b&gt;suppliers&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;color:#666666;&#39;&gt;índices: ++id, name&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;id&lt;/b&gt; : number — PK (auto)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;name&lt;/b&gt; : string&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;type : string&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;locations : string[]&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="160" width="320" x="640" y="60" as="geometry" />
        </mxCell>
        <mxCell id="er-pr" parent="1" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;overflow=fill;" value="&lt;table style=&#39;width:100%;border-collapse:collapse;font-size:10px;&#39; border=&#39;1&#39; cellpadding=&#39;4&#39;&gt;&lt;tr&gt;&lt;td bgcolor=&#39;#2d5f8b&#39; align=&#39;center&#39; style=&#39;color:#ffffff;&#39;&gt;&lt;b&gt;products&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;color:#666666;&#39;&gt;índices: ++id, title, area, purchase.nextPurchaseDate&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;id&lt;/b&gt; : number — PK (auto)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;title&lt;/b&gt; : string (obligatorio) — nombre genérico&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;brand : string — marca&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;model : string — variante / descriptor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;content : string — ej. &#39;500&#39;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;unit : L · ml · g · kg · pza · paq&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;family : string — categoría&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;area : string — zona de la casa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;description : string&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;image : Blob — foto del producto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;iconKey / iconTone : string&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;customProps : [{key, value}]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;stock&lt;/b&gt; : {current, min, max, location?, alerts?}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;purchase&lt;/b&gt; : {primarySupplierId?, secondarySupplierIds[], originalPrice?, lastPrice?, lastPurchaseDate?, nextPurchaseDate?, period, links[], supplierLinks?}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;createdAt / updatedAt : ISO-8601&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="500" width="340" x="140" y="290" as="geometry" />
        </mxCell>
        <mxCell id="er-cart" parent="1" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;overflow=fill;" value="&lt;table style=&#39;width:100%;border-collapse:collapse;font-size:10px;&#39; border=&#39;1&#39; cellpadding=&#39;4&#39;&gt;&lt;tr&gt;&lt;td bgcolor=&#39;#2a7a7a&#39; align=&#39;center&#39; style=&#39;color:#ffffff;&#39;&gt;&lt;b&gt;carts&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;color:#666666;&#39;&gt;índices: ++id, status, createdAt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;id&lt;/b&gt; : number — PK (auto)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;name&lt;/b&gt; : string&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;status&lt;/b&gt; : active · purchased · cancelled&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;origin&lt;/b&gt; : manual · auto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;createdAt : ISO-8601&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;generatedAt : ISO (solo auto)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;purchasedAt : ISO (solo comprados)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;budget : centavos MXN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;estimatedDate : &#39;AAAA-MM-DD&#39;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;items&lt;/b&gt; : [{productId, title, qty,&lt;br&gt;unitPrice, supplierId, supplierName}]&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
